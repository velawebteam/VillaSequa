rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Since we are using hardcoded credentials 'imo'/'12345' in the UI for admin,
    // we will allow all admin operations for now.
    // IN PRODUCTION: This should be restricted to authenticated admins via Firebase Auth.
    function isAdmin() {
      return true; // Temporary placeholder until Firebase Auth is integrated
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'location', 'type', 'status', 'visibility', 'category', 'reference']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number &&
             data.location is string && data.location.size() <= 200;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'firstName', 'lastName', 'phone', 'email', 'interest']) &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.email is string && data.email.size() <= 100 &&
             data.interest in ['compra', 'venda', 'arrendamento'];
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'type', 'status']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.type in ['evaluation', 'contact', 'info', 'newsletter', 'match'] &&
             data.status in ['new', 'contacted', 'qualified', 'lost'];
    }

    function isValidNewsletterTemplate(data) {
      return data.keys().hasAll(['id', 'name', 'content']) &&
             data.name is string && data.name.size() <= 200 &&
             data.content is string && data.content.size() <= 50000;
    }

    function isValidSentNewsletter(data) {
      return data.keys().hasAll(['templateId', 'propertyIds', 'recipientEmails', 'sentAt']) &&
             data.templateId is string &&
             data.propertyIds is list &&
             data.recipientEmails is list &&
             data.sentAt is string;
    }

    match /properties/{propertyId} {
      allow get: if (resource == null || existing().visibility == 'visível' || isAdmin());
      allow list: if true; 
      allow write: if isAdmin() && isValidProperty(incoming());
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin() && (request.method != 'create' || isValidClient(incoming()));
    }

    match /leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read, write: if isAdmin();
    }

    match /newsletter_templates/{templateId} {
      allow read, write: if isAdmin() && (request.method != 'create' || isValidNewsletterTemplate(incoming()));
    }

    match /sent_newsletters/{newsletterId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidSentNewsletter(incoming());
    }

    match /config/website {
      allow get: if true;
      allow write: if isAdmin();
    }
    
    match /config/{document} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
